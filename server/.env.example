# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://buildsite:CHANGE_ME@localhost:5432/buildsite?schema=public

# ── Auth ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_MINIMUM
ACCESS_TOKEN_TTL=15m          # matches mobile 15-min idle force-logout window
REFRESH_TOKEN_TTL=7d
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ── SMS provider (OTP delivery) ───────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+15550000000

# ── AWS S3 (photo assets) ─────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=buildsite-photos-prod
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
PRESIGN_UPLOAD_TTL_SECONDS=300
CDN_BASE_URL=https://cdn.buildsite.example

# ── Firebase Cloud Messaging ──────────────────────────────
FCM_PROJECT_ID=buildsite-app
GOOGLE_APPLICATION_CREDENTIALS=./secrets/fcm-service-account.json

# ── App ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS=exp.host,localhost:8081,yourdomain.app
